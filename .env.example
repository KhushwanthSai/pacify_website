# Copy to .env and fill in. On Vercel, add these under
# Settings → Environment Variables instead (same names, same values).

# ── Supabase: client-side ──────────────────────────────────────────────
# Safe to expose — these ship to the browser. Find them in your Supabase
# dashboard under Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# ── Supabase: server-side ──────────────────────────────────────────────
# Same URL and anon key, read by SSR and server functions. Kept separate
# because import.meta.env is not available in every server context.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# SECRET — bypasses row-level security. Never prefix this with VITE_ and
# never commit it. Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI analysis (optional) ─────────────────────────────────────────────
# Google AI Studio key: https://aistudio.google.com/apikey
# Leave unset and the readiness analysis returns a neutral baseline score
# instead of a model-generated one — the app still runs.
GEMINI_API_KEY=
