# Copy to .env and fill in. On Vercel, add these under
# Settings → Environment Variables instead (same names, same values).

# ── Supabase: client-side ──────────────────────────────────────────────
# Safe to expose — these ship to the browser. Find them in your Supabase
# dashboard under Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# ── Supabase: server-side ──────────────────────────────────────────────
# Same URL and anon key, read by SSR and server functions. Kept separate
# because import.meta.env is not available in every server context.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# REQUIRED for the admin panel at /admin — it reads and edits every user's
# data, which means bypassing row-level security. The rest of the app runs
# fine without it.
#
# SECRET: never prefix with VITE_ and never commit it.
# Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ── GitHub (optional) ──────────────────────────────────────────────────
# The GitHub score is computed from real public API data. Unauthenticated
# access allows 60 requests/hour per IP, which is fine for local use. Add a
# token (no scopes needed — public data only) to raise it to 5,000/hour.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ── AI analysis (optional) ─────────────────────────────────────────────
# Google AI Studio key: https://aistudio.google.com/apikey
# Leave unset and the readiness analysis returns a neutral baseline score
# instead of a model-generated one — the app still runs.
GEMINI_API_KEY=
